{
  "$schema": "http://json.schemastore.org/template",
  "author": "Rodrigo",
  "classifications": [
    "Web",
    "WebAPI",
    "Clean Architecture"
  ],
  "identity": "Rodrigosdk.CleanApi",
  "name": "Clean Architecture Web API (.NET 10)",
  "description": "API REST em camadas (Api, Application, Domain, Infrastructure, Communication, Exception) com ProblemDetails, EF Core, Docker, CI e testes com Testcontainers; banco, autenticação JWT, logging e observabilidade escolhidos na geração.",
  "shortName": "cleanapi",
  "tags": {
    "language": "C#",
    "type": "solution"
  },
  "sourceName": "Template",
  "preferNameDirectory": true,
  "guids": [
    "96af9c62-c157-4d99-92bb-5e10b29e5064"
  ],
  "sources": [
    {
      "modifiers": [
        {
          "exclude": [
            ".git/**",
            ".idea/**",
            ".vs/**",
            ".template.config/**",
            "TEMPLATE.md",
            "**/bin/**",
            "**/obj/**",
            "**/TestResults/**",
            "**/*.DotSettings.user",
            "pack/**",
            "artifacts/**",
            ".github/workflows/publish.yml"
          ]
        },
        {
          "condition": "(!postgres || !auth)",
          "exclude": [
            "src/Backend/Template.Infrastructure/DataAccess/Migrations/2*.cs",
            "src/Backend/Template.Infrastructure/DataAccess/Migrations/TemplateDbContextModelSnapshot.cs"
          ]
        },
        {
          "condition": "(!auth)",
          "exclude": [
            "src/Backend/Template.Api/Controllers/AuthenticationController.cs",
            "src/Backend/Template.Api/Controllers/UsersController.cs",
            "src/Backend/Template.Api/Security/**",
            "src/Backend/Template.Application/Users/**",
            "src/Backend/Template.Domain/Entities/User.cs",
            "src/Backend/Template.Domain/Repositories/Users/**",
            "src/Backend/Template.Domain/Security/**",
            "src/Backend/Template.Infrastructure/Configuration/JwtOptions.cs",
            "src/Backend/Template.Infrastructure/DataAccess/Mappings/UserMap.cs",
            "src/Backend/Template.Infrastructure/DataAccess/Repositories/**",
            "src/Backend/Template.Infrastructure/Security/**",
            "src/Shared/Template.Communication/Requests/RequestUserJson.cs",
            "src/Shared/Template.Communication/Requests/RequestLoginJson.cs",
            "src/Shared/Template.Communication/Responses/ResponseLoginJson.cs",
            "src/Shared/Template.Communication/Responses/ResponseRegisteredUserJson.cs",
            "src/Shared/Template.Communication/Responses/ResponseTokenJson.cs",
            "src/Shared/Template.Communication/Responses/ResponseUserProfileJson.cs",
            "tests/src/CommonTestUtilities/Entities/**",
            "tests/src/CommonTestUtilities/Generators/**",
            "tests/src/CommonTestUtilities/Repositories/Users/**",
            "tests/src/CommonTestUtilities/Requests/**",
            "tests/src/CommonTestUtilities/Security/**",
            "tests/src/Template.Api.IntegrationTests/Authentication/**",
            "tests/src/Template.Api.IntegrationTests/Users/**",
            "tests/src/Template.Application.Tests/Users/**",
            "tests/src/Template.Domain.Tests/Entities/**",
            "tests/src/Template.Infrastructure.Tests/DatabaseFixture.cs",
            "tests/src/Template.Infrastructure.Tests/Commit/**",
            "tests/src/Template.Infrastructure.Tests/Security/**",
            "tests/src/Template.Infrastructure.Tests/Users/**"
          ]
        },
        {
          "condition": "(!logging)",
          "exclude": [
            "src/Backend/Template.Api/Logging/RequestLoggingSetup.cs",
            "src/Backend/Template.Application/Logging/**",
            "tests/src/CommonTestUtilities/Loggers/**"
          ]
        },
        {
          "condition": "(!observability)",
          "exclude": [
            "src/Backend/Template.Api/Observability/ObservabilitySetup.cs"
          ]
        },
        {
          "condition": "(!postgres)",
          "exclude": [
            "docker/pgadmin/**"
          ]
        },
        {
          "condition": "(!postgres && !observability)",
          "exclude": [
            "docker/compose.dev.yml"
          ]
        }
      ]
    },
    {
      "source": "./.template.config/migrations/sqlserver/",
      "target": "./src/Backend/Template.Infrastructure/DataAccess/Migrations/",
      "condition": "(sqlserver && auth)"
    },
    {
      "source": "./.template.config/migrations/mysql/",
      "target": "./src/Backend/Template.Infrastructure/DataAccess/Migrations/",
      "condition": "(mysql && auth)"
    }
  ],
  "symbols": {
    "database": {
      "type": "parameter",
      "datatype": "choice",
      "defaultValue": "postgres",
      "description": "Banco de dados usado pela API, pelos testes e pelo docker compose.",
      "choices": [
        {
          "choice": "postgres",
          "description": "PostgreSQL"
        },
        {
          "choice": "sqlserver",
          "description": "SQL Server"
        },
        {
          "choice": "mysql",
          "description": "MySQL"
        }
      ]
    },
    "auth": {
      "type": "parameter",
      "datatype": "bool",
      "defaultValue": "true",
      "description": "Inclui cadastro de usuários, login com JWT (Argon2) e exige token nos endpoints."
    },
    "logging": {
      "type": "parameter",
      "datatype": "bool",
      "defaultValue": "true",
      "description": "Inclui o log por requisição (HttpLogging) e o catálogo de logs de negócio dos casos de uso."
    },
    "observability": {
      "type": "parameter",
      "datatype": "bool",
      "defaultValue": "true",
      "description": "Inclui OpenTelemetry (traces, métricas e logs via OTLP) e o Aspire Dashboard no compose de desenvolvimento."
    },
    "postgres": {
      "type": "computed",
      "value": "(database == \"postgres\")"
    },
    "sqlserver": {
      "type": "computed",
      "value": "(database == \"sqlserver\")"
    },
    "mysql": {
      "type": "computed",
      "value": "(database == \"mysql\")"
    }
  },
  "SpecialCustomOperations": {
    "**/*.resx": {
      "operations": [
        {
          "type": "conditional",
          "configuration": {
            "if": [
              "<!--#if"
            ],
            "else": [
              "<!--#else"
            ],
            "elseif": [
              "<!--#elseif",
              "<!--#elif"
            ],
            "endif": [
              "<!--#endif"
            ],
            "trim": "true",
            "wholeLine": "true"
          }
        }
      ]
    },
    "**/*.md": {
      "operations": [
        {
          "type": "conditional",
          "configuration": {
            "if": [
              "<!--#if"
            ],
            "else": [
              "<!--#else"
            ],
            "elseif": [
              "<!--#elseif",
              "<!--#elif"
            ],
            "endif": [
              "<!--#endif"
            ],
            "trim": "true",
            "wholeLine": "true"
          }
        }
      ]
    }
  }
}
