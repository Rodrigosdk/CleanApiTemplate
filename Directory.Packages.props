<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup Label="Aplicação">
    <!--#if (auth) -->
    <PackageVersion Include="Konscious.Security.Cryptography.Argon2" Version="1.3.1" />
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.15" />
    <PackageVersion Include="Microsoft.IdentityModel.JsonWebTokens" Version="8.19.2" />
    <!--#endif -->
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.15" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="10.0.15" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.15" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.15" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.15" />
    <PackageVersion Include="Microsoft.Extensions.Diagnostics.HealthChecks.EntityFrameworkCore" Version="10.0.15" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.15" />
    <!--#if (logging) -->
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.15" />
    <!--#endif -->
    <PackageVersion Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.15" />
    <!--#if (postgres) -->
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <!--#elif (sqlserver) -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.15" />
    <!--#else -->
    <PackageVersion Include="MySql.EntityFrameworkCore" Version="10.0.12" />
    <!--#endif -->
    <!--#if (observability) -->
    <!--#if (postgres) -->
    <PackageVersion Include="Npgsql.OpenTelemetry" Version="10.0.3" />
    <!--#elif (sqlserver) -->
    <PackageVersion Include="OpenTelemetry.Instrumentation.SqlClient" Version="1.21.0" />
    <!--#endif -->
    <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.21.0" />
    <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.21.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.21.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Http" Version="1.21.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Runtime" Version="1.21.0" />
    <!--#endif -->
    <PackageVersion Include="Swashbuckle.AspNetCore.SwaggerUI" Version="10.3.1" />
  </ItemGroup>
  <ItemGroup Label="Testes">
    <PackageVersion Include="Bogus" Version="35.6.5" />
    <PackageVersion Include="coverlet.collector" Version="10.1.0" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.15" />
    <PackageVersion Include="Microsoft.Extensions.Configuration" Version="10.0.15" />
    <PackageVersion Include="Microsoft.Extensions.Diagnostics.Testing" Version="10.11.0" />
    <PackageVersion Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.11.0" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.12.0" />
    <PackageVersion Include="Moq" Version="4.21.0" />
    <PackageVersion Include="Shouldly" Version="4.3.0" />
    <!--#if (postgres) -->
    <PackageVersion Include="Testcontainers.PostgreSql" Version="4.16.0" />
    <!--#elif (sqlserver) -->
    <PackageVersion Include="Testcontainers.MsSql" Version="4.16.0" />
    <!--#else -->
    <PackageVersion Include="Testcontainers.MySql" Version="4.16.0" />
    <!--#endif -->
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.1" />
  </ItemGroup>
</Project>
